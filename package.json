{
  "name": "apocalize-maximally",
  "private": true,
  "workspaces": [
    "packages/backend",
    "packages/frontend",
    "packages/data-management"
  ],
  "scripts": {
    "build": "yarn workspace @apocalize/frontend build && yarn workspace @apocalize/backend build",
    "lint": "eslint .",
    "synth:backend": "yarn workspace @apocalize/backend synth",
    "synth:frontend": "yarn workspace @apocalize/frontend synth",
    "synth:assets": "yarn workspace @apocalize/db-management synth",
    "deploy:backend": "yarn workspace @apocalize/backend deploy",
    "deploy:frontend": "yarn workspace @apocalize/frontend deploy",
    "deploy:assets": "yarn workspace @apocalize/db-management deploy",
    "update:db": "yarn workspace @apocalize/db-management update"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "packageManager": "yarn@4.13.0",
  "dependencies": {
    "globals": "^17.13.0"
  }
}
