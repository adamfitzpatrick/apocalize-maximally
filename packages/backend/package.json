{
  "name": "@apocalize/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/handler.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/handler/index.js",
    "synth": "yarn build && cdk synth",
    "deploy": "yarn build && cdk deploy --require-approval never"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.800.0",
    "@aws-sdk/lib-dynamodb": "^3.800.0",
    "aws-cdk-lib": "^2.200.0",
    "constructs": "^10.4.2",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^22.13.10",
    "aws-cdk": "^2.1000.0",
    "esbuild": "~0.25.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
